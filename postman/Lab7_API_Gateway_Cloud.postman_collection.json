		{
			"name": "5. Error Handling & Resilience (502/503)",
			"item": [
				{
					"name": "GET /products - Downstream Service Unreachable Test",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/products",
							"host": ["{{baseUrl}}"],
							"path": ["products"]
						},
						"description": "Verifies that when a target backend microservice is stopped or unreachable, the gateway responds with HTTP 503 Service Unavailable and a clear JSON error payload without crashing."
					}
				},
				{
					"name": "GET /unknown - Unmatched Route 404",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/non-existent-route",
							"host": ["{{baseUrl}}"],
							"path": ["non-existent-route"]
						},
						"description": "Tests gateway fallback handler for unregistered paths."
					}
				}
			]
		},
