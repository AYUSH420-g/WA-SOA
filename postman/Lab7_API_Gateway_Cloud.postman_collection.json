			"item": [
				{
					"name": "GET /health - Verify Gateway Status & Registry",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": ["{{baseUrl}}"],
							"path": ["health"]
						},
						"description": "Checks the API Gateway's own health status, uptime, and active service discovery routing table."
					}
				}
			]
		},
