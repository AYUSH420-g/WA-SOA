{
	"info": {
		"_postman_id": "lab7-api-gateway-collection-2026",
		"name": "Lab 7: API Gateway, Service Discovery & Cloud Deployment",
		"description": "Comprehensive Postman test collection for Web Services & SOA Lab 7: API Gateway routing, /health checks, configuration-based service discovery, centralized 502/503 error handling, and cloud deployment verification.",
