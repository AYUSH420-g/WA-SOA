      "name": "1. Positive Tests (CRUD against MongoDB)",
      "item": [
        {
          "name": "1. GET All Students",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response returns student array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students"
              ]
            },
            "description": "Retrieves the full list of enrolled student documents from MongoDB Atlas."
          }
        },
        {
          "name": "2. POST Create Student (Captures MongoDB ID)",
