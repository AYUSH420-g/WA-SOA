# =======================================================
# Lab 7 Environment Configuration Template
# API Gateway, Service Discovery & Cloud Deployment
# =======================================================

# API Gateway Port (Exposed externally)
PORT=8080

# Service Discovery (Configuration-Based URLs)
# In Docker Compose, these resolve via container DNS names:
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# Internal Service Ports
USER_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003

# Inter-Service Communication Settings
REQUEST_TIMEOUT_MS=3000

# Cloud MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusconnect?retryWrites=true&w=majority

# Cloud Deployment URL (e.g. Render / Railway)
PUBLIC_GATEWAY_URL=https://api-gateway-campusconnect.onrender.com

# Application environment
NODE_ENV=production
